{
  "name": "agent-travel-frontend",
  "private": true,
  "version": "0.0.1",
  "description": "Vue 3 frontend engineering scaffold for the travel planning platform",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "overrides": {
    "glob": "10.5.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build:mock"
  },
  "dependencies": {
    "element-plus": "2.14.6",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
