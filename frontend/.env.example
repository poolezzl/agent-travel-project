# Copy to .env.local for a local backend connection; never commit .env.local.
VITE_APP_PROFILE=local
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_ENABLE_MOCK=false

# Browser-only, restricted Amap credentials are configured only when map UI is implemented.
# VITE_AMAP_JS_KEY=
# VITE_AMAP_SECURITY_CODE=
