{
  "$id": "agents/06-reservation-rules/output.schema.json",
  "properties": {
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^agent-contract-v[0-9]+$"
    },
    "degraded_fields": {
      "minItems": 1,
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point_id",
          "policy_id",
          "ticket_type",
          "effective_from",
          "effective_until",
          "timezone",
          "last_verified",
          "stale"
        ],
        "properties": {
          "point_id": {
            "type": "string"
          },
          "policy_id": {
            "type": "string"
          },
          "ticket_type": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timezone": {
            "type": "string"
          },
          "last_verified": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "audience": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "reservation_required": {
            "type": "boolean"
          },
          "free_condition": {
            "type": "string"
          },
          "holiday_exception": {
            "type": "string"
          }
        }
      }
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "trace_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_metadata": {
      "$ref": "#/definitions/source_metadata"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "degraded",
        "failed"
      ]
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point_id",
          "policy_id",
          "action",
          "release_at",
          "advance_days",
          "timezone",
          "dedupe_key",
          "status"
        ],
        "properties": {
          "point_id": {
            "type": "string"
          },
          "policy_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "reserve"
            ]
          },
          "release_at": {
            "type": "string",
            "format": "date-time"
          },
          "advance_days": {
            "type": "integer",
            "minimum": 0
          },
          "timezone": {
            "type": "string"
          },
          "dedupe_key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "missed",
              "needs_verification"
            ]
          },
          "warning": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "trace_id",
    "request_id",
    "generated_at",
    "status",
    "source_metadata"
  ],
  "title": "reservationOutput",
  "type": "object",
  "definitions": {
    "source_metadata": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "map",
              "weather",
              "knowledge_base",
              "reservation_rule",
              "poi",
              "user_input",
              "system"
            ]
          },
          "freshness_status": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "source_record_id": {
            "minLength": 1,
            "type": "string"
          },
          "is_estimated": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "source_type",
          "source_record_id",
          "retrieved_at"
        ]
      },
      "type": "array"
    },
    "envelope": {
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^agent-contract-v[0-9]+$"
        },
        "degraded_fields": {
          "minItems": 1,
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "trace_id": {
          "minLength": 1,
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "degraded",
            "failed"
          ]
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "trace_id",
        "request_id",
        "generated_at",
        "status"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "then": {
        "required": [
          "error_code",
          "message"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "else": {}
    },
    {
      "then": {
        "required": [
          "message",
          "degraded_fields"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reservations",
          "timeline"
        ]
      }
    }
  ]
}
