{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/06-reservation-rules/input.schema.json",
  "title": "ReservationRulesInput",
  "description": "预约规则 Agent 的输入契约：景点列表 + 游玩日期。",
  "type": "object",
  "additionalProperties": false,
  "required": ["points", "date"],
  "properties": {
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "city_id", "name"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "city_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "description": "已消歧的景点列表"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "游玩日期"
    }
  }
}
