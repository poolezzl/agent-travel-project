{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/04-attractions/input.schema.json",
  "title": "AttractionsInput",
  "description": "景点资讯 Agent 的输入契约：景点列表 + 用户偏好标签。",
  "type": "object",
  "additionalProperties": false,
  "required": ["points"],
  "properties": {
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "city_id", "name"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "city_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "description": "已消歧的景点列表"
    },
    "preference_tags": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string" },
      "description": "用户偏好标签，如「亲子」「拍照」「历史」，用于筛选玩法侧重"
    }
  }
}
