{
  "additionalProperties": false,
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "properties": {
    "transport_preference": {
      "type": "string",
      "enum": [
        "步行",
        "公交",
        "地铁",
        "打车",
        "混合"
      ]
    },
    "must_visit_spots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "user_request": {
      "minLength": 1,
      "type": "string"
    },
    "preference_tags": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "maxItems": 50
    },
    "plan_count": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "date_range": {
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "type": "object",
      "required": [
        "start",
        "end"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "cities": {
      "minItems": 1,
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "type": "object",
  "required": [
    "user_request"
  ],
  "title": "OrchestratorInput",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/01-orchestrator/input.schema.json"
}
