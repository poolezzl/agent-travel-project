{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/01-orchestrator/output.schema.json",
  "title": "OrchestratorOutput",
  "description": "总控调度 Agent 的输出契约：最终行程方案（整合各子 Agent 结果）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "trace_id", "request_id", "generated_at", "status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "degraded", "failed"],
      "description": "ok=完整；partial=部分子项缺失；degraded=触发降级；failed=失败"
    },
    "message": { "type": "string", "description": "降级/失败时的人类可读说明" },
    "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "失败时的稳定错误码" },
    "degraded_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "降级/缺失的字段名（来自子 Agent 的 degraded_fields 汇总）"
    },
    "schema_version": { "type": "string", "description": "Schema 版本，由系统注入，模型不得伪造" },
    "task_id": { "type": "string", "description": "任务 ID，由系统注入" },
    "trace_id": { "type": "string", "description": "链路追踪 ID，由系统注入" },
    "request_id": { "type": "string", "description": "请求 ID，由系统注入" },
    "generated_at": { "type": "string", "format": "date-time", "description": "生成时间，由系统注入" },
    "source_metadata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "source_record_id", "retrieved_at"],
        "properties": {
          "source_type": { "type": "string", "enum": ["map", "weather", "knowledge_base", "reservation_rule", "poi", "user_input", "system"] },
          "source_record_id": { "type": "string", "minLength": 1 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "valid_until": { "type": ["string", "null"], "format": "date-time" },
          "freshness_status": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
          "is_estimated": { "type": "boolean" }
        }
      },
      "description": "最终计划引用的来源索引，由系统汇总"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "budget", "days"],
      "properties": {
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_days", "city_order", "theme_summary", "pace_assessment"],
          "properties": {
            "total_days": { "type": "integer", "minimum": 1 },
            "city_order": { "type": "array", "items": { "type": "string" } },
            "theme_summary": { "type": "string" },
            "pace_assessment": { "type": "string", "enum": ["紧凑", "适中", "宽松"] }
          },
          "description": "行程总览（总天数/城市顺序/主题概括/节奏评估，见需求 2.1）"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tickets", "meals", "lodging", "transport"],
          "properties": {
            "tickets": { "$ref": "#/definitions/budget_item" },
            "meals": { "$ref": "#/definitions/budget_item" },
            "lodging": { "$ref": "#/definitions/budget_item" },
            "transport": { "$ref": "#/definitions/budget_item" }
          },
          "description": "预算明细面板（门票/餐饮/住宿/交通分维度，见需求 2.1）"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/day_plan" },
          "description": "按日期升序的逐日行程"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["error_code", "message"] },
      "else": { "required": ["plan", "source_metadata"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["partial", "degraded"] } }, "required": ["status"] },
      "then": {
        "required": ["message", "degraded_fields"],
        "properties": { "degraded_fields": { "minItems": 1 } }
      }
    }
  ],
  "definitions": {
    "budget_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "scope", "currency"],
      "properties": {
        "precision": { "type": "string", "enum": ["exact", "range", "unknown"] },
        "scope": { "type": "string", "enum": ["total", "per_person"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "CNY" },
        "amount_minor": { "type": "integer", "minimum": 0 },
        "min_amount_minor": { "type": "integer", "minimum": 0 },
        "max_amount_minor": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "precision": { "const": "exact" } }, "required": ["precision"] }, "then": { "required": ["amount_minor"] } },
        { "if": { "properties": { "precision": { "const": "range" } }, "required": ["precision"] }, "then": { "required": ["min_amount_minor", "max_amount_minor"] } }
      ]
    },
    "day_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "segments"],
      "properties": {
        "date": { "$ref": "#/definitions/date" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/segment" },
          "description": "当日点位序列（由路线规划 Agent 排序）"
        },
        "meals": {
          "type": "array",
          "items": { "$ref": "#/definitions/meal" },
          "description": "餐饮建议（来自餐饮住宿 Agent）"
        },
        "lodging": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["poi_id", "name", "source", "latitude", "longitude", "retrieved_at"],
            "properties": {
              "poi_id": { "type": "string" },
              "name": { "type": "string" },
              "source": { "type": "string", "enum": ["poi", "unknown"] },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "area": { "type": "string", "description": "所在区域" },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "price_per_night_minor": { "type": "integer", "minimum": 0 },
              "retrieved_at": { "type": "string", "format": "date-time" },
              "reason": { "type": "string", "description": "推荐理由" }
            }
          },
          "description": "住宿建议（来自餐饮住宿 Agent）"
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data_type", "source_record_id", "retrieved_at"],
          "properties": {
            "condition": { "type": "string" },
            "temp_min": { "type": "integer" },
            "temp_max": { "type": "integer" },
            "data_type": { "type": "string", "enum": ["forecast", "climate_statistics"] },
            "source_record_id": { "type": "string" },
            "retrieved_at": { "type": "string", "format": "date-time" },
            "valid_until": { "type": ["string", "null"], "format": "date-time" }
          },
          "description": "当日天气摘要（来自气象服务 Agent）"
        },
        "reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point_id", "point", "policy_id", "stale"],
            "properties": {
              "point_id": { "type": "string" },
              "point": { "type": "string", "description": "景点名" },
              "policy_id": { "type": "string" },
              "require_reservation": { "type": "boolean" },
              "book_window_days": { "type": "integer", "minimum": 0 },
              "stale": { "type": "boolean" },
              "tips": { "type": "array", "items": { "type": "string" } }
            }
          },
          "description": "预约时间线（来自预约规则 Agent）"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "point_id", "arrival", "departure", "source_record_id", "retrieved_at"],
      "properties": {
        "point": { "type": "string", "description": "点位名" },
        "point_id": { "type": "string" },
        "arrival": { "$ref": "#/definitions/time" },
        "departure": { "$ref": "#/definitions/time" },
        "transport": { "type": "string", "enum": ["步行", "公交", "地铁", "打车"] },
        "duration_min": { "type": "integer", "minimum": 0, "description": "前往该点通勤时长" },
        "distance_m": { "type": "integer", "minimum": 0 },
        "source_record_id": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "is_estimated": { "type": "boolean", "description": "true=通勤时长来自路线规划降级估算" }
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "candidates"],
      "properties": {
        "slot": { "type": "string", "enum": ["早餐", "午餐", "晚餐"] },
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["poi_id", "name", "source", "latitude", "longitude", "retrieved_at"],
            "properties": {
              "poi_id": { "type": "string" },
              "name": { "type": "string" },
              "source": { "type": "string", "enum": ["poi", "unknown"] },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "cuisine": { "type": "string", "description": "菜系" },
              "detour_min": { "type": "integer", "minimum": 0, "description": "绕路时长（分钟）" },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "avg_price_minor": { "type": "integer", "minimum": 0, "description": "人均价（最小货币单位）" },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "HH:MM 24小时制" }
  }
}
