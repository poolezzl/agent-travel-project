{
  "$id": "agents/02-route-planner/output.schema.json",
  "properties": {
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^agent-contract-v[0-9]+$"
    },
    "degraded_fields": {
      "minItems": 1,
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_points",
        "segments",
        "is_estimated"
      ],
      "properties": {
        "ordered_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "segments": {
          "type": "array"
        },
        "is_estimated": {
          "type": "boolean"
        }
      }
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "trace_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_metadata": {
      "$ref": "#/definitions/source_metadata"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "degraded",
        "failed"
      ]
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "trace_id",
    "request_id",
    "generated_at",
    "status",
    "source_metadata"
  ],
  "title": "routeOutput",
  "type": "object",
  "definitions": {
    "source_metadata": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "map",
              "weather",
              "knowledge_base",
              "reservation_rule",
              "poi",
              "user_input",
              "system"
            ]
          },
          "freshness_status": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "source_record_id": {
            "minLength": 1,
            "type": "string"
          },
          "is_estimated": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "source_type",
          "source_record_id",
          "retrieved_at"
        ]
      },
      "type": "array"
    },
    "envelope": {
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^agent-contract-v[0-9]+$"
        },
        "degraded_fields": {
          "minItems": 1,
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "trace_id": {
          "minLength": 1,
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "degraded",
            "failed"
          ]
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "trace_id",
        "request_id",
        "generated_at",
        "status"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "then": {
        "required": [
          "error_code",
          "message"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "else": {}
    },
    {
      "then": {
        "required": [
          "message",
          "degraded_fields"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "route"
        ]
      }
    }
  ]
}
