{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/02-route-planner/input.schema.json",
  "title": "RoutePlannerInput",
  "description": "路线规划 Agent 的输入契约：当日点位集合、交通偏好、时间窗。",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "city_id", "coordinate_system", "points", "time_window"],
  "properties": {
    "date": { "$ref": "#/definitions/date" },
    "city_id": { "type": "string", "minLength": 1, "description": "平台标准城市 ID" },
    "coordinate_system": { "type": "string", "enum": ["GCJ02"], "description": "国内地图统一使用 GCJ-02" },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "name", "latitude", "longitude", "stay_min"],
        "properties": {
          "point_id": { "type": "string" },
          "name": { "type": "string" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "stay_min": { "type": "integer", "minimum": 0, "description": "建议停留时长（分钟）" },
          "open_time": { "$ref": "#/definitions/time", "description": "开门时间" },
          "close_time": { "$ref": "#/definitions/time", "description": "闭门时间" }
        }
      },
      "description": "当日待排序点位集合"
    },
    "origin": { "$ref": "#/definitions/location", "description": "当日起点，如酒店" },
    "destination": { "$ref": "#/definitions/location", "description": "当日终点，如酒店" },
    "transport_preference": {
      "type": "string",
      "enum": ["步行", "公交", "地铁", "打车", "混合"],
      "description": "交通方式偏好"
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/definitions/time", "description": "当日行程开始时间" },
        "end": { "$ref": "#/definitions/time", "description": "当日行程结束时间" }
      }
    }
  },
  "definitions": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "latitude", "longitude"],
      "properties": {
        "point_id": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
  }
}
