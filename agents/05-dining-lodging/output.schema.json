{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/05-dining-lodging/output.schema.json",
  "title": "DiningLodgingOutput",
  "description": "餐饮住宿 Agent 的输出契约：每餐候选与住宿建议。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "trace_id", "request_id", "generated_at", "status"],
  "properties": {
    "schema_version": { "type": "string" },
    "task_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "degraded", "failed"]
    },
    "message": { "type": "string", "description": "降级时说明，如「附近暂无推荐」" },
    "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "degraded_fields": { "type": "array", "items": { "type": "string" } },
    "meals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "candidates"],
        "properties": {
          "slot": { "type": "string", "enum": ["早餐", "午餐", "晚餐"] },
          "candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["poi_id", "name", "source", "latitude", "longitude", "retrieved_at"],
              "properties": {
                "poi_id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "description": "店名" },
                "source": { "type": "string", "enum": ["poi", "unknown"] },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "cuisine": { "type": "string", "description": "菜系" },
                "detour_min": { "type": "integer", "minimum": 0, "description": "绕路时长（分钟），顺路性依据" },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "avg_price_minor": { "type": "integer", "minimum": 0, "description": "人均价（最小货币单位）" },
                "retrieved_at": { "type": "string", "format": "date-time" }
              }
            },
            "description": "每餐 2~3 个候选；降级时为空数组"
          }
        }
      },
      "description": "按三餐槽位的餐饮候选"
    },
    "lodging": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["poi_id", "name", "source", "latitude", "longitude", "retrieved_at"],
        "properties": {
          "poi_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "source": { "type": "string", "enum": ["poi", "unknown"] },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "area": { "type": "string", "description": "所在区域" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "price_per_night_minor": { "type": "integer", "minimum": 0 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "description": "推荐理由（如离行程中心近）" }
        }
      },
      "description": "每晚住宿建议"
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "required": ["error_code", "message"] }, "else": { "required": ["meals", "lodging"] } },
    { "if": { "properties": { "status": { "enum": ["partial", "degraded"] } }, "required": ["status"] }, "then": { "required": ["message", "degraded_fields"], "properties": { "degraded_fields": { "minItems": 1 } } } }
  ]
}
