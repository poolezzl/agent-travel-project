{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/05-dining-lodging/input.schema.json",
  "title": "DiningLodgingInput",
  "description": "餐饮住宿 Agent 的输入契约：行程草案、口味偏好、预算区间。",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "itinerary_draft"],
  "properties": {
    "date": { "$ref": "#/definitions/date" },
    "itinerary_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point_id", "latitude", "longitude"],
            "properties": {
              "point_id": { "type": "string" },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "description": "当日已消歧点位序列（用于判断顺路性）"
        },
        "area": { "type": "string", "description": "所在片区/区域" }
      },
      "description": "当日行程草案"
    },
    "taste_preference": {
      "type": "array",
      "items": { "type": "string" },
      "description": "口味偏好，如「川菜」「素食」「清真」"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "CNY" },
        "meal_per_person_minor": { "type": "integer", "minimum": 0, "description": "人均餐标（最小货币单位）" },
        "lodging_per_night_minor": { "type": "integer", "minimum": 0, "description": "每晚住宿预算（最小货币单位）" }
      }
    },
    "companion": {
      "type": "string",
      "description": "同行人构成，如「带老人」「带小孩」「朋友结伴」「独自出行」，影响餐饮/住宿推荐策略。"
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
