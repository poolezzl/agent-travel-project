{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/03-weather/input.schema.json",
  "title": "WeatherInput",
  "description": "气象服务 Agent 的输入契约：城市 + 日期范围 + 天气敏感点。",
  "type": "object",
  "additionalProperties": false,
  "required": ["city_id", "date_range", "today", "forecast_horizon_days"],
  "properties": {
    "city_id": {
      "type": "string",
      "minLength": 1,
      "description": "平台标准城市 ID。"
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/definitions/date" },
        "end": { "$ref": "#/definitions/date" }
      },
      "description": "查询日期范围（闭区间）。业务规则：end ≥ start。"
    },
    "today": {
      "$ref": "#/definitions/date",
      "description": "当前日期（由系统注入），用于判定预报 vs 气候统计的分界。"
    },
    "forecast_horizon_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "供应商实际预报窗口天数（含今天），由适配器注入。"
    },
    "sensitive_points": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1 },
      "description": "天气敏感点，例如「日出」「爬山」「晾晒」。可选。"
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" }
  }
}
