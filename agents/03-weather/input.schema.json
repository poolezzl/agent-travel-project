{
  "additionalProperties": false,
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "properties": {
    "date_range": {
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "type": "object",
      "required": [
        "start",
        "end"
      ]
    },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "forecast_horizon_days": {
      "type": "integer",
      "minimum": 0
    },
    "city_id": {
      "minLength": 1,
      "type": "string"
    },
    "sensitive_points": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "type": "object",
  "required": [
    "city_id",
    "date_range",
    "today",
    "forecast_horizon_days"
  ],
  "title": "WeatherInput",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agents/03-weather/input.schema.json"
}
