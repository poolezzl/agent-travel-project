{
  "$id": "agents/03-weather/output.schema.json",
  "properties": {
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^agent-contract-v[0-9]+$"
    },
    "degraded_fields": {
      "minItems": 1,
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "source_metadata": {
      "$ref": "#/definitions/source_metadata"
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "trace_id": {
      "minLength": 1,
      "type": "string"
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "temp_min",
          "temp_max",
          "precip_prob",
          "condition",
          "data_type",
          "source_record_id",
          "retrieved_at",
          "valid_until"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "temp_min": {
            "type": "number"
          },
          "temp_max": {
            "type": "number"
          },
          "precip_prob": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "condition": {
            "type": "string"
          },
          "data_type": {
            "type": "string",
            "enum": [
              "forecast",
              "climate_statistics"
            ]
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "forecast_published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "travel_advice": {
      "type": "object",
      "description": "仅由 daily[] 已返回事实派生的机器可读建议；没有独立来源，禁止写入 daily[] 之外的事实。冻结于 2026-11-24。",
      "additionalProperties": false,
      "required": ["sensitive_points", "risks", "alternatives", "clothing"],
      "properties": {
        "sensitive_points": {
          "type": "array",
          "description": "每个天气敏感点的可行性判断；缺少天气数据时 feasible=false 并带 DATA_MISSING 风险。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point", "feasible", "risks"],
            "properties": {
              "point": {
                "type": "string",
                "minLength": 1
              },
              "feasible": {
                "type": "boolean"
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(HEAVY_RAIN|EXTREME_TEMP|NON_FORECAST|DATA_MISSING):[0-9]{4}-[0-9]{2}-[0-9]{2}(,[0-9]{4}-[0-9]{2}-[0-9]{2})*$"
                }
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "description": "机器可读风险码：<CODE>:<YYYY-MM-DD>[,<YYYY-MM-DD>...]；无风险时为空数组。",
          "items": {
            "type": "string",
            "pattern": "^(HEAVY_RAIN|EXTREME_TEMP|NON_FORECAST|DATA_MISSING):[0-9]{4}-[0-9]{2}-[0-9]{2}(,[0-9]{4}-[0-9]{2}-[0-9]{2})*$"
          }
        },
        "alternatives": {
          "type": "array",
          "description": "无风险日期；仅可引用 daily[] 中已返回的日期。",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "clothing": {
          "type": ["string", "null"],
          "description": "仅当用户显式询问着装时给出，基于已返回温度；否则为 null。"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "degraded",
        "failed"
      ]
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "trace_id",
    "request_id",
    "generated_at",
    "status",
    "source_metadata"
  ],
  "title": "weatherOutput",
  "type": "object",
  "definitions": {
    "source_metadata": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "map",
              "weather",
              "knowledge_base",
              "reservation_rule",
              "poi",
              "user_input",
              "system"
            ]
          },
          "freshness_status": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "source_record_id": {
            "minLength": 1,
            "type": "string"
          },
          "is_estimated": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "source_type",
          "source_record_id",
          "retrieved_at"
        ]
      },
      "type": "array"
    },
    "envelope": {
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^agent-contract-v[0-9]+$"
        },
        "degraded_fields": {
          "minItems": 1,
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "trace_id": {
          "minLength": 1,
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "degraded",
            "failed"
          ]
        },
        "request_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "trace_id",
        "request_id",
        "generated_at",
        "status"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "then": {
        "required": [
          "error_code",
          "message"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "else": {}
    },
    {
      "then": {
        "required": [
          "message",
          "degraded_fields"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "degraded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "daily",
          "travel_advice"
        ]
      }
    }
  ]
}
