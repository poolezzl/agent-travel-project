# Runtime profile: mock or real
APP_PROFILE=mock
ADAPTER_MODE=mock
ADAPTER_CONNECT_TIMEOUT_MS=1000
ADAPTER_HTTP_MAX_RESPONSE_BYTES=1048576
AGENT_SERVICE_NAME=travelstar-agent-service
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8000
# Java -> Python S19 orchestrator. Leave empty to keep the local mock executor.
AGENT_SERVICE_BASE_URL=
AGENT_SERVICE_CONNECT_TIMEOUT=2s
AGENT_SERVICE_READ_TIMEOUT=120s
AGENT_KNOWLEDGE_CATALOG=resources/published_catalog.json
AGENT_DINING_POI_SOURCE=resources/dining_lodging_pois.json
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8080

# MySQL / Redis
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=trip_planner
MYSQL_USERNAME=trip_planner
MYSQL_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_random_characters
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# S11 task runtime
S11_ENABLED=true
S11_OPERATION_TIMEOUT_SECONDS=180
S11_LEASE_SECONDS=30
S11_HEARTBEAT_INTERVAL_MS=10000
S11_MAX_STEP_ATTEMPTS=3
S11_OUTBOX_MAX_ATTEMPTS=5
S11_WORKER_GROUP=s11-workers-v1

# LLM gateway (keep mock for local development and tests)
LLM_PROVIDER=mock
LLM_BASE_URL=https://replace.example/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# One-shot real-model smoke guard; keep false except for the approved test
LLM_MIN_CALL_APPROVED=false

# Provider selection for the Python agent service (mock keeps offline behavior)
WEATHER_PROVIDER=mock
ROUTE_PROVIDER=mock

# Amap: server and browser credentials must be separate
AMAP_BASE_URL=https://restapi.amap.com
AMAP_API_KEY=
AMAP_TIMEOUT_MS=5000
AMAP_WEB_KEY=replace_me
VITE_AMAP_JS_KEY=replace_me
VITE_AMAP_SECURITY_CODE=replace_me

# Python -> Java authoritative POI-by-ID (contracts/s12/poi-lookup.md, DRAFT)
AGENT_INTERNAL_KNOWLEDGE_URL=http://127.0.0.1:8080
POI_LOOKUP_BACKEND_ENABLED=true
POI_LOOKUP_CACHE_TTL_SECONDS=300
POI_LOOKUP_TIMEOUT_SECONDS=3

# ALG-12 preference memory parameters (app.preferences.*).
# Defaults are proposals pending R1/R3 sign-off; see docs/alg-12-parameter-decision.md.
PREFERENCES_TOP_K=5
PREFERENCES_TOP_K_MAX=20
PREFERENCES_CITY_TOP_N=5
PREFERENCES_MIN_CONFIDENCE=0.6
PREFERENCES_WEIGHT_INCREMENT=3
PREFERENCES_WEIGHT_CAP=100
PREFERENCES_DECAY_ENABLED=true
PREFERENCES_DECAY_HALF_LIFE_DAYS=180
PREFERENCES_DECAY_FLOOR=1
PREFERENCES_RULE_VERSION=s24-alg12-v1
PREFERENCES_DIMENSIONS=city,theme,pace,budget,season
PREFERENCES_DEFAULT_CONFIDENCE=0.7
PREFERENCES_CITY_CONFIDENCE=0.8
PREFERENCES_PACE_RELAXED_MAX_POINTS_PER_DAY=2
PREFERENCES_PACE_MODERATE_MAX_POINTS_PER_DAY=4
PREFERENCES_BUDGET_ECONOMY_MAX_YUAN=1000
PREFERENCES_BUDGET_COMFORT_MAX_YUAN=5000

# TianAPI licensed scenic data: draft import only, never auto-publish
TIANAPI_BASE_URL=https://apis.tianapi.com
TIANAPI_KEY=replace_me
TIANAPI_TIMEOUT_SECONDS=10

# QWeather
QWEATHER_API_HOST=replace.example
QWEATHER_API_KEY=replace_me
QWEATHER_FORECAST_DAYS=3
QWEATHER_ZONE_ID=Asia/Shanghai

# Local paths; production must use restricted directories outside the source tree
OBJECT_STORAGE_PATH=./data/objects
CHROMA_PATH=./data/chroma
BACKUP_PATH=./data/backups
