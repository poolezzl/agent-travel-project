{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/s19/plan.schema.json",
  "title": "S19 final plan",
  "description": "S19 最终行程方案契约。plan 是 agents/01-orchestrator/output.schema.json 中 plan 字段的结构化定义；事实字段必须带来源，未知/估算/过期必须显式。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "generated_at",
    "sample_only",
    "trip",
    "summary",
    "days",
    "quality",
    "conflicts",
    "confirmation",
    "sources",
    "degraded_fields"
  ],
  "properties": {
    "plan_version": {
      "type": "string",
      "const": "s19-plan-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sample_only": {
      "type": "boolean",
      "description": "true 表示方案基于 S06 合成样例数据，不得对外宣称为真实旅行事实"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "trip": {
      "$ref": "#/definitions/trip"
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/day"
      }
    },
    "quality": {
      "$ref": "#/definitions/quality"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conflict"
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "conflict_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "degraded_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_record_id", "retrieved_at"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "map",
            "weather",
            "knowledge_base",
            "reservation_rule",
            "poi",
            "user_input",
            "system"
          ]
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "freshness_status": {
          "type": "string",
          "enum": ["fresh", "stale", "unknown"]
        },
        "is_estimated": {
          "type": "boolean"
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount_minor"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "enum": ["total", "per_person", "per_night", "known_ticket_rules"]
        }
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city_id",
        "city_name",
        "start_date",
        "end_date",
        "day_count",
        "party_size",
        "transport_preference"
      ],
      "properties": {
        "city_id": {
          "type": "string",
          "minLength": 1
        },
        "city_name": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "day_count": {
          "type": "integer",
          "minimum": 1
        },
        "party_size": {
          "type": "integer",
          "minimum": 1
        },
        "transport_preference": {
          "type": "string",
          "enum": ["步行", "公交", "地铁", "打车", "混合"]
        },
        "budget": {
          "$ref": "#/definitions/money"
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "point_count",
        "total_distance_m",
        "total_transport_min",
        "estimated_route_legs",
        "estimated_cost",
        "source_completeness",
        "degraded",
        "stale_fields",
        "unknown_fields"
      ],
      "properties": {
        "point_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "total_transport_min": {
          "type": "number",
          "minimum": 0
        },
        "estimated_route_legs": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost": {
          "$ref": "#/definitions/money"
        },
        "source_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "degraded": {
          "type": "boolean"
        },
        "stale_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "date"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "degraded", "unknown"]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "condition": {
          "type": ["string", "null"]
        },
        "temp_min": {
          "type": ["number", "null"]
        },
        "temp_max": {
          "type": ["number", "null"]
        },
        "precip_prob": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "data_type": {
          "type": ["string", "null"],
          "enum": ["forecast", "climate_statistics", null]
        },
        "source_record_id": {
          "type": ["string", "null"]
        },
        "retrieved_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_no",
        "point_id",
        "name",
        "start_time",
        "end_time",
        "duration_min",
        "duration_source",
        "is_must_visit",
        "is_estimated",
        "facts"
      ],
      "properties": {
        "sequence_no": {
          "type": "integer",
          "minimum": 1
        },
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "district": {
          "type": ["string", "null"]
        },
        "category": {
          "type": "string"
        },
        "start_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "end_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "duration_source": {
          "type": "string",
          "enum": ["knowledge", "assumed"]
        },
        "is_must_visit": {
          "type": "boolean"
        },
        "is_estimated": {
          "type": "boolean"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["fact_type", "value", "source_record_id"],
            "properties": {
              "fact_type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "chunk_id": {
                "type": ["string", "null"]
              },
              "source_record_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "transport_to_next": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "distance_m",
                "duration_min",
                "is_estimated",
                "source_record_id",
                "retrieved_at"
              ],
              "properties": {
                "mode": {
                  "type": "string"
                },
                "distance_m": {
                  "type": "number",
                  "minimum": 0
                },
                "duration_min": {
                  "type": "number",
                  "minimum": 0
                },
                "is_estimated": {
                  "type": "boolean"
                },
                "source_record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["date", "meal", "anchor_point_id", "candidates"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "meal": {
          "type": "string",
          "enum": ["lunch", "dinner"]
        },
        "anchor_point_id": {
          "type": "string"
        },
        "start_time": {
          "type": ["string", "null"],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "lodging": {
      "type": "object",
      "additionalProperties": true,
      "required": ["date", "candidates"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "area": {
          "type": ["string", "null"]
        },
        "anchor_point_id": {
          "type": ["string", "null"]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["point_id", "policy_id", "reservation_required", "stale"],
      "properties": {
        "point_id": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "ticket_type": {
          "type": "string"
        },
        "audience": {
          "type": ["string", "null"]
        },
        "reservation_required": {
          "type": "boolean"
        },
        "channel": {
          "type": ["string", "null"]
        },
        "currency": {
          "type": ["string", "null"]
        },
        "amount_minor": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "free_condition": {
          "type": ["string", "null"]
        },
        "effective_from": {
          "type": ["string", "null"]
        },
        "effective_until": {
          "type": ["string", "null"]
        },
        "timezone": {
          "type": ["string", "null"]
        },
        "last_verified": {
          "type": ["string", "null"]
        },
        "holiday_exception": {
          "type": ["string", "null"]
        },
        "stale": {
          "type": "boolean"
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "weekday", "city_id", "weather", "segments", "meals", "lodging", "reservations", "warnings"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "weekday": {
          "type": "string"
        },
        "city_id": {
          "type": "string"
        },
        "weather": {
          "$ref": "#/definitions/weather"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/segment"
          }
        },
        "meals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/meal"
          }
        },
        "lodging": {
          "$ref": "#/definitions/lodging"
        },
        "reservations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reservation"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "fail"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status", "message"],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "status": {
                "type": "string",
                "enum": ["pass", "warn", "fail", "skipped"]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "options"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": ["blocking", "warning"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "affected_days": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option_id", "label", "impact"],
            "properties": {
              "option_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}